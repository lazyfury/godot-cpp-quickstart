[configuration]

entry_symbol = "data_binding_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

macos.debug = "res://addons/data_binding/bin/libdata_binding.macos.template_debug.framework"
macos.release = "res://addons/data_binding/bin/libdata_binding.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/data_binding/bin/libdata_binding.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/data_binding/bin/libdata_binding.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/data_binding/bin/libdata_binding.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/data_binding/bin/libdata_binding.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/data_binding/bin/libdata_binding.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/data_binding/bin/libdata_binding.linux.template_release.arm64.so"
