[configuration]

entry_symbol = "quickstart_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

macos.debug = "res://bin/libquickstart.macos.template_debug.framework"
macos.release = "res://bin/libquickstart.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libquickstart.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libquickstart.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libquickstart.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libquickstart.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libquickstart.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libquickstart.linux.template_release.arm64.so"
android.debug.arm64 = "res://bin/libquickstart.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libquickstart.android.template_release.arm64.so"
web.debug.wasm32 = "res://bin/libquickstart.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/libquickstart.web.template_release.wasm32.wasm"
